#!/usr/bin/env python3
"""
agent-dock-bell: Focus-Aware Completion Alarm & Dock Badge Daemon for AI CLI Agents.

Supported Agent CLIs:
- Google Antigravity CLI (via hooks.json Stop hook)
- Codex CLI (via hooks.json Stop hook)
- Hermes Agent (via config.yaml on_session_end hook)
- Generic shell commands (via trap or post-execution wrapper)

Architecture:
- High-speed Launcher (<50ms): returns valid JSON `{}` immediately to avoid agent hook timeouts / SIGKILL.
- Detached Background Daemon:
  * Plays audio completion chime in loop (PipeWire / Canberra fallback).
  * Emits Unity LauncherEntry badge ('1') and urgency on Ubuntu/GNOME Dock.
  * Sets X11 XUrgencyHint via ctypes on the terminal window.
  * Monitors root window focus changes via `xprop -spy _NET_ACTIVE_WINDOW`.
  * Instantly cleans up (stops audio, clears badge, stops dock dance, closes notification)
    as soon as the user focuses or clicks the terminal.
"""

import os
import sys
import time
import re
import json
import signal
import select
import threading
import subprocess
import ctypes
from ctypes import c_ulong, c_long, c_int, c_void_p, Structure, POINTER
from pathlib import Path

# 1. X11 Definitions for UrgencyHint
class XWMHints(Structure):
    _fields_ = [
        ("flags", c_long),
        ("input", c_int),
        ("initial_state", c_int),
        ("icon_pixmap", c_ulong),
        ("icon_window", c_ulong),
        ("icon_x", c_int),
        ("icon_y", c_int),
        ("icon_mask", c_ulong),
        ("window_group", c_ulong)
    ]

XUrgencyHint = (1 << 8)

try:
    x11 = ctypes.CDLL("libX11.so.6")
    x11.XOpenDisplay.restype = c_void_p
    x11.XGetWMHints.restype = POINTER(XWMHints)
    x11.XSetWMHints.argtypes = [c_void_p, c_ulong, POINTER(XWMHints)]
    x11.XFree.argtypes = [c_void_p]
    x11.XFlush.argtypes = [c_void_p]
    x11.XCloseDisplay.argtypes = [c_void_p]
    disp = x11.XOpenDisplay(None)
except Exception:
    x11 = None
    disp = None

# 2. Audio & Timing Configuration
PRESET_SOUNDS = {
    "bell": "/usr/share/sounds/Yaru/stereo/bell.oga",                  # Subtle Ubuntu ding (0.28s)
    "pop": "/usr/share/sounds/Yaru/stereo/message-new-instant.oga",    # Clean message bubble pop (0.42s)
    "click": str(Path.home() / ".local/share/sounds/click-dry.ogg"),  # Dry acoustic wood tap (0.38s)
    "complete": "/usr/share/sounds/freedesktop/stereo/complete.oga",   # Classic freedesktop chime
}

sound_choice = os.environ.get("AGENT_ALARM_SOUND", "bell").strip()
if sound_choice in PRESET_SOUNDS and os.path.exists(PRESET_SOUNDS[sound_choice]):
    SOUND_FILE = PRESET_SOUNDS[sound_choice]
elif os.path.isfile(sound_choice):
    SOUND_FILE = sound_choice
elif os.path.exists(PRESET_SOUNDS["bell"]):
    SOUND_FILE = PRESET_SOUNDS["bell"]
elif os.path.exists(PRESET_SOUNDS["complete"]):
    SOUND_FILE = PRESET_SOUNDS["complete"]
else:
    SOUND_FILE = PRESET_SOUNDS.get("click", "")

VOLUME = os.environ.get("AGENT_ALARM_VOLUME", "1.0").strip()
MAX_AUDIO_SECONDS = int(os.environ.get("AGENT_ALARM_MAX_AUDIO", "180"))  # Max audio loop (3 minutes)
MAX_TOTAL_SECONDS = int(os.environ.get("AGENT_ALARM_MAX_WAIT", "600"))   # Max wait timeout (10 minutes)
PID_FILE = f"/tmp/agent-dock-bell-{os.getuid()}.pid"
LEGACY_PID_FILE = f"/tmp/agent-alarm-{os.getuid()}.pid"

# Daemon State
stop_event = threading.Event()
active_audio_proc = None
audio_lock = threading.Lock()
notification_id = None
active_desktop_id = "org.gnome.Terminal.desktop"
marked_urgency_wids = set()
spy_process = None

def to_int(val):
    if val is None:
        return None
    if isinstance(val, int):
        return val
    try:
        s = str(val).strip()
        if s.startswith("0x") or s.startswith("0X"):
            return int(s, 16)
        return int(s)
    except Exception:
        return None

def get_ancestor_pids():
    pids = []
    curr = os.getpid()
    while curr > 1:
        try:
            with open(f"/proc/{curr}/status") as f:
                for line in f:
                    if line.startswith("PPid:"):
                        curr = int(line.split()[1])
                        pids.append(curr)
                        break
        except Exception:
            break
    return set(pids)

def get_active_window_id():
    try:
        out = subprocess.check_output(["xprop", "-root", "_NET_ACTIVE_WINDOW"], stderr=subprocess.DEVNULL).decode()
        m = re.search(r"0x[0-9a-fA-F]+", out)
        if m:
            return m.group(0).lower()
    except Exception:
        pass
    return None

def find_terminal_windows(ancestor_pids):
    term_wids = set()
    term_pids = set()
    detected_desktop_id = "org.gnome.Terminal.desktop"
    try:
        out = subprocess.check_output(["xprop", "-root", "_NET_CLIENT_LIST"], stderr=subprocess.DEVNULL).decode()
        for wid in re.findall(r"0x[0-9a-fA-F]+", out):
            try:
                props = subprocess.check_output(["xprop", "-id", wid, "_NET_WM_PID", "WM_CLASS"], stderr=subprocess.DEVNULL).decode()
                pid = None
                wm_class = ""
                for line in props.splitlines():
                    if "_NET_WM_PID" in line:
                        try:
                            pid = int(line.split("=")[1].strip())
                        except Exception:
                            pass
                    elif "WM_CLASS" in line:
                        wm_class = line.lower()
                
                is_match = False
                if pid and pid in ancestor_pids:
                    is_match = True
                    term_pids.add(pid)
                elif any(t in wm_class for t in ["gnome-terminal", "terminal", "ptyxis", "alacritty", "kitty", "tilix"]):
                    is_match = True
                    if pid:
                        term_pids.add(pid)

                if is_match:
                    w_int = to_int(wid)
                    if w_int is not None:
                        term_wids.add(w_int)
                    if "code" in wm_class:
                        detected_desktop_id = "code.desktop"
                    elif "gnome-terminal" in wm_class:
                        detected_desktop_id = "org.gnome.Terminal.desktop"
            except Exception:
                pass
    except Exception:
        pass
    return term_wids, term_pids, detected_desktop_id

def set_dock_badge(desktop_id, count, urgent=True):
    for app_uri in [f"application://{desktop_id}", desktop_id]:
        c_vis = "true" if count > 0 else "false"
        urg_val = "true" if urgent else "false"
        subprocess.run([
            "gdbus", "emit", "--session",
            "--object-path", "/com/canonical/unity/launcherentry/1",
            "--signal", "com.canonical.Unity.LauncherEntry.Update",
            app_uri,
            f"{{'count': <int64 {count}>, 'count-visible': <{c_vis}>, 'urgent': <{urg_val}>}}"
        ], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)

def set_window_urgency(wid, enable=True):
    if not (x11 and disp):
        return
    try:
        wid_int = to_int(wid)
        if wid_int is None:
            return
        hints = x11.XGetWMHints(disp, wid_int)
        if hints:
            if enable:
                hints.contents.flags |= XUrgencyHint
                marked_urgency_wids.add(wid_int)
            else:
                hints.contents.flags &= ~XUrgencyHint
                marked_urgency_wids.discard(wid_int)
            x11.XSetWMHints(disp, wid_int, hints)
            x11.XFlush(disp)
    except Exception:
        pass

def send_notification(agent_name, desktop_id):
    try:
        cmd = [
            "notify-send", "-p",
            "-u", "normal",
            "-a", agent_name,
            "-i", "org.gnome.Terminal",
            "-h", f"string:desktop-entry:{desktop_id}",
            "Task Completed!",
            f"{agent_name} has finished executing."
        ]
        out = subprocess.check_output(cmd, stderr=subprocess.DEVNULL).decode().strip()
        if out.isdigit():
            return int(out)
    except Exception:
        pass
    return None

def close_notification(nid):
    if not nid:
        return
    try:
        subprocess.run([
            "gdbus", "call", "--session",
            "--dest", "org.freedesktop.Notifications",
            "--object-path", "/org/freedesktop/Notifications",
            "--method", "org.freedesktop.Notifications.CloseNotification",
            str(nid)
        ], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
    except Exception:
        pass

def reset_dock_dance():
    try:
        subprocess.run([
            "gsettings", "set", "org.gnome.shell.extensions.dash-to-dock",
            "dance-urgent-applications", "false"
        ], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
        time.sleep(0.05)
        subprocess.run([
            "gsettings", "set", "org.gnome.shell.extensions.dash-to-dock",
            "dance-urgent-applications", "true"
        ], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
    except Exception:
        pass

def get_sound_cmd(sound_file):
    cmd = ["pw-play"]
    if VOLUME and VOLUME not in ("1.0", "1", ""):
        cmd.extend(["--volume", str(VOLUME)])
    cmd.append(sound_file)
    return cmd

def play_single_sound():
    if not SOUND_FILE or not os.path.exists(SOUND_FILE):
        return
    cmd = get_sound_cmd(SOUND_FILE)
    try:
        r = subprocess.run(cmd, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, timeout=2.0)
        if r.returncode != 0:
            subprocess.run(["canberra-gtk-play", "-f", SOUND_FILE], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, timeout=2.0)
    except Exception:
        try:
            subprocess.run(["canberra-gtk-play", "-f", SOUND_FILE], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, timeout=2.0)
        except Exception:
            pass

def audio_worker():
    start_time = time.time()
    while not stop_event.is_set():
        if time.time() - start_time > MAX_AUDIO_SECONDS:
            break
        
        p = None
        with audio_lock:
            if stop_event.is_set():
                break
            try:
                cmd = get_sound_cmd(SOUND_FILE)
                p = subprocess.Popen(cmd, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
            except Exception:
                try:
                    p = subprocess.Popen(["canberra-gtk-play", "-f", SOUND_FILE], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
                except Exception:
                    p = None
            global active_audio_proc
            active_audio_proc = p
        
        if p:
            try:
                p.wait(timeout=2.0)
            except subprocess.TimeoutExpired:
                try:
                    p.kill()
                    p.wait(timeout=0.5)
                except Exception:
                    pass
            with audio_lock:
                active_audio_proc = None
        
        if stop_event.wait(3.0):
            break

def cleanup():
    stop_event.set()
    with audio_lock:
        global active_audio_proc
        if active_audio_proc and active_audio_proc.poll() is None:
            try:
                active_audio_proc.terminate()
                active_audio_proc.wait(timeout=0.2)
            except Exception:
                try:
                    active_audio_proc.kill()
                except Exception:
                    pass
            active_audio_proc = None
    
    if SOUND_FILE:
        try:
            subprocess.run(["pkill", "-u", str(os.getuid()), "-f", SOUND_FILE], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
        except Exception:
            pass
    try:
        subprocess.run(["pkill", "-u", str(os.getuid()), "-x", "pw-play"], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
        subprocess.run(["pkill", "-u", str(os.getuid()), "-x", "canberra-gtk-play"], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
    except Exception:
        pass

    global spy_process
    if spy_process and spy_process.poll() is None:
        try:
            spy_process.terminate()
        except Exception:
            pass

    # 1. Clear dock badge
    set_dock_badge(active_desktop_id, 0, urgent=False)

    # 2. Clear X11 Urgency
    for wid in list(marked_urgency_wids):
        set_window_urgency(wid, False)

    # 3. Close desktop notification
    close_notification(notification_id)

    # 4. Stop dock icon animation actor
    reset_dock_dance()

    # 5. Remove PID lock file
    for p_file in [PID_FILE, LEGACY_PID_FILE]:
        try:
            if os.path.exists(p_file):
                with open(p_file) as f:
                    pid_in_file = int(f.read().strip())
                if pid_in_file == os.getpid():
                    os.remove(p_file)
        except Exception:
            pass

    # 6. Close X11 display
    if disp and x11:
        try:
            x11.XCloseDisplay(disp)
        except Exception:
            pass

def on_signal(signum, frame):
    cleanup()
    sys.exit(0)

def kill_existing_daemon():
    for p_file in [PID_FILE, LEGACY_PID_FILE]:
        if os.path.exists(p_file):
            try:
                with open(p_file) as f:
                    old_pid = int(f.read().strip())
                if old_pid != os.getpid():
                    os.kill(old_pid, signal.SIGTERM)
                    for _ in range(10):
                        time.sleep(0.02)
                        try:
                            os.kill(old_pid, 0)
                        except OSError:
                            break
            except Exception:
                pass
            try:
                if os.path.exists(p_file):
                    os.remove(p_file)
            except Exception:
                pass

def run_daemon(agent_name, desktop_id, term_wids, term_pids):
    global active_desktop_id, notification_id, spy_process
    active_desktop_id = desktop_id

    try:
        with open(PID_FILE, "w") as f:
            f.write(str(os.getpid()))
    except Exception:
        pass

    signal.signal(signal.SIGINT, on_signal)
    signal.signal(signal.SIGTERM, on_signal)
    signal.signal(signal.SIGHUP, on_signal)

    try:
        # 1. Enable badge "1" and urgent state on Ubuntu Dock
        set_dock_badge(active_desktop_id, 1, urgent=True)

        # 2. Enable XUrgencyHint on terminal windows
        for wid in term_wids:
            set_window_urgency(wid, True)

        # 3. Fire visual notification
        notification_id = send_notification(agent_name, active_desktop_id)

        # 4. Start background looped chime
        audio_thread = threading.Thread(target=audio_worker, daemon=True)
        audio_thread.start()

        # 5. Monitor window focus
        try:
            spy_process = subprocess.Popen(
                ["xprop", "-spy", "-root", "_NET_ACTIVE_WINDOW"],
                stdout=subprocess.PIPE,
                stderr=subprocess.DEVNULL,
                text=True
            )

            start_wait = time.time()
            for line in spy_process.stdout:
                if time.time() - start_wait > MAX_TOTAL_SECONDS:
                    break
                
                m = re.search(r"0x[0-9a-fA-F]+", line)
                if m:
                    new_active_hex = m.group(0)
                    new_active_int = to_int(new_active_hex)
                    if new_active_int and new_active_int != 0:
                        if new_active_int in term_wids:
                            break
                        try:
                            p_out = subprocess.check_output(
                                ["xprop", "-id", new_active_hex, "_NET_WM_PID", "WM_CLASS"],
                                stderr=subprocess.DEVNULL
                            ).decode()
                            is_term = False
                            for pline in p_out.splitlines():
                                if "_NET_WM_PID" in pline:
                                    try:
                                        n_pid = int(pline.split("=")[1].strip())
                                        if n_pid in term_pids:
                                            is_term = True
                                            break
                                    except Exception:
                                        pass
                                elif "WM_CLASS" in pline:
                                    if any(t in pline.lower() for t in ["gnome-terminal", "terminal", "ptyxis", "alacritty", "kitty"]):
                                        is_term = True
                                        break
                            if is_term:
                                break
                        except Exception:
                            pass
        except Exception:
            pass
    finally:
        cleanup()
    sys.exit(0)

def should_skip_event(raw_stdin, payload):
    if "--test" in sys.argv or "--dry-run" in sys.argv:
        return True

    if raw_stdin:
        if "test-session" in raw_stdin or "synthetic" in raw_stdin:
            return True

    if isinstance(payload, dict):
        # 1. Antigravity CLI Stop Hook:
        if payload.get("fullyIdle") is False:
            return True

        # 2. Hermes Hooks:
        event_name = payload.get("hook_event_name")
        if event_name and event_name != "on_session_end":
            return True
        extra = payload.get("extra")
        if isinstance(extra, dict):
            if extra.get("completed") is False or extra.get("interrupted") is True:
                return True

        # 3. Codex CLI Stop Hook:
        stop_reason = payload.get("stop_reason")
        if stop_reason in ("tool_use", "intermediate"):
            return True

    return False

def main():
    # Daemon Execution Mode
    if "--daemon" in sys.argv:
        d_idx = sys.argv.index("--daemon")
        agent_name = sys.argv[d_idx + 1] if len(sys.argv) > d_idx + 1 else "AI Agent"
        desktop_id = sys.argv[d_idx + 2] if len(sys.argv) > d_idx + 2 else "org.gnome.Terminal.desktop"
        wids_raw = sys.argv[d_idx + 3] if len(sys.argv) > d_idx + 3 else ""
        pids_raw = sys.argv[d_idx + 4] if len(sys.argv) > d_idx + 4 else ""

        term_wids = {to_int(w) for w in wids_raw.split(",") if to_int(w) is not None}
        term_pids = {to_int(p) for p in pids_raw.split(",") if to_int(p) is not None}

        if not term_wids:
            wids, pids, d_id = find_terminal_windows(get_ancestor_pids())
            term_wids = wids
            term_pids = pids
            if d_id:
                desktop_id = d_id

        run_daemon(agent_name, desktop_id, term_wids, term_pids)
        return

    # Fast Launcher Mode (<50ms exit)
    raw_stdin = ""
    payload = None
    if not sys.stdin.isatty():
        try:
            r, _, _ = select.select([sys.stdin], [], [], 0.05)
            if r:
                raw_stdin = sys.stdin.read()
                try:
                    payload = json.loads(raw_stdin)
                except Exception:
                    pass
        except Exception:
            pass

    if should_skip_event(raw_stdin, payload):
        print("{}")
        sys.exit(0)

    # Determine agent name
    agent_name = "AI Agent"
    for arg in sys.argv[1:]:
        if not arg.startswith("--"):
            agent_name = arg.strip()
            break

    # Terminal audible bell (send to tty/stderr so stdout stays pure JSON)
    try:
        with open("/dev/tty", "w") as tty:
            tty.write('\a')
            tty.flush()
    except Exception:
        sys.stderr.write('\a')
        sys.stderr.flush()

    ancestors = get_ancestor_pids()
    term_wids, term_pids, desktop_id = find_terminal_windows(ancestors)
    current_active = get_active_window_id()
    current_active_int = to_int(current_active)

    is_already_active = False
    if current_active_int and current_active_int in term_wids:
        is_already_active = True

    if is_already_active and not ("--force" in sys.argv):
        # User is already looking at the terminal window
        play_single_sound()
        send_notification(agent_name, desktop_id)
        print("{}")
        sys.exit(0)

    # User is in another window: launch detached daemon
    kill_existing_daemon()

    wids_arg = ",".join(str(w) for w in term_wids)
    pids_arg = ",".join(str(p) for p in (term_pids | ancestors))
    daemon_cmd = [
        sys.executable,
        os.path.abspath(__file__),
        "--daemon",
        agent_name,
        desktop_id,
        wids_arg,
        pids_arg
    ]

    subprocess.Popen(
        daemon_cmd,
        stdin=subprocess.DEVNULL,
        stdout=subprocess.DEVNULL,
        stderr=subprocess.DEVNULL,
        start_new_session=True,
        close_fds=True
    )

    print("{}")
    sys.exit(0)

if __name__ == "__main__":
    main()
